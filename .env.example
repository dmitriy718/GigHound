# GigHound — example environment. See docs/environment.md for the full reference.

# --- Text generation (Ollama) ---
# In Docker this defaults to http://ollama:11434/v1 automatically;
# on a local machine it defaults to http://localhost:11434/v1.
# Set explicitly for any other Ollama host (e.g. a LAN box):
# OLLAMA_BASE_URL=http://your-ollama-host:11434/v1
OLLAMA_MODEL=qwen3:4b
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=1024
OLLAMA_TIMEOUT=120
OLLAMA_REASONING_HEADROOM=6144

# --- Hosted LLM fallback (optional) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
LLM_MAX_RPM=60

# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg2://gighound:gighound@localhost:5432/gighound
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
# Postgres container password — required by docker-compose.yml (no default).
POSTGRES_PASSWORD=gighound
# Credential-vault encryption key — MANDATORY outside dev mode
# (the vault fails fast without it unless GIGHOUND_DEV_NOAUTH=1; in dev an
# ephemeral key is persisted to backend/.vault-dev-key). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GIGHOUND_VAULT_KEY=

# --- Auth (required in production) ---
# JWT signing secret — the API refuses to start without it unless DEV_NOAUTH=1.
# GIGHOUND_SECRET_KEY=
# Dev escape hatch: all requests run as a single implicit dev user. Never in prod.
# GIGHOUND_DEV_NOAUTH=1
# Set to false for a closed deployment (no self-service signups).
# GIGHOUND_ALLOW_REGISTRATION=true

# --- Rate governor (Phase 4.5) ---
# Per-(platform, principal) daily action budgets (searches + submissions),
# counted in Redis as rl:{platform}:{principal}:{date}. Unset = unlimited;
# when Redis is down the check is a graceful no-op.
# GIGHOUND_DAILY_CAP_LINKEDIN=30
# GIGHOUND_DAILY_CAP_UPWORK=40
# GIGHOUND_DAILY_CAP_FREELANCER=40

# --- Digest email (optional) ---
# Hourly/daily job digests are always generated; without SMTP_HOST they are
# only logged, never emailed. DIGEST_FROM defaults to gighound@localhost.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# DIGEST_FROM=gighound@example.com
# DIGEST_TO=you@example.com

# --- Frontend serving (Phase 4.1) ---
# Where the backend looks for the built SPA (StaticFiles + index.html
# fallback). Defaults to <repo>/frontend/dist locally, /app/frontend/dist in
# the Docker image. Set only for custom layouts.
# GIGHOUND_FRONTEND_DIST=

# --- Stealth worker (AD-4) ---
# Shared token the browser worker pool uses for claim/complete/result posting.
# Mandatory outside dev (backend fails fast without it). Also set it in the
# worker's environment.
# GIGHOUND_WORKER_TOKEN=

# --- Freelancer OAuth (optional; /api/accounts/{id}/oauth/freelancer/*) ---
# Without these the OAuth start endpoint returns 501 and users enroll
# Freelancer tokens manually via POST /api/accounts/{id}/credentials.
# FREELANCER_CLIENT_ID=
# FREELANCER_CLIENT_SECRET=
# FREELANCER_REDIRECT_URI=http://localhost:5173/oauth/freelancer/callback
