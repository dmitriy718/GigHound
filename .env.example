# GigHound — example environment. See docs/environment.md for the full reference.

# --- Text generation (Ollama) ---
# In Docker this defaults to http://ollama:11434/v1 automatically;
# on the LAN it defaults to http://192.168.1.68:11434/v1. Set explicitly to override:
# OLLAMA_BASE_URL=http://192.168.1.68:11434/v1
OLLAMA_MODEL=qwen3:4b
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=1024
OLLAMA_TIMEOUT=120
OLLAMA_REASONING_HEADROOM=6144

# --- Hosted LLM fallback (optional) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
LLM_MAX_RPM=60

# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg2://gighound:gighound@localhost:5432/gighound
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
# GIGHOUND_VAULT_KEY=
